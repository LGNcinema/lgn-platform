{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",

      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },

    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",

      "functions": {
        "app/main.py": {
          "maxDuration": 60,
          "excludeFiles": "{app/design/**,app/inspect_*.py,app/parse_all_figma.py,inspect_json.py,.venv/**,**/__pycache__/**}"
        }
      }
    }
  },

  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
