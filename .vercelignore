# Files uploaded to Vercel on every deploy. Everything here is local-only, so
# keeping it out shortens uploads and keeps the function bundle small.
#
# Only exclude things NO service needs at build or run time -- an over-eager
# entry here surfaces as a "module not found" at build, not at review.

# Local Python environment and caches
backend/.venv/
**/__pycache__/
.pytest_cache/

# Figma exports and the one-off scripts that read them. Dev tooling for
# rebuilding components from design, never imported by the running API.
design/
backend/app/design/
backend/app/inspect_*.py
backend/app/parse_all_figma.py
backend/inspect_json.py

# Local build output -- Vercel builds the frontend itself.
frontend/dist/

# Schema tooling. Migrations and the seed are applied from a dev machine with
# backend/migrate.py, never by a deploy -- a serverless function must not be
# changing the schema it is serving. copy_db.py is the one-off Supabase -> Neon
# data move and has no business in a deployment at all.
backend/migrations/
backend/seed.sql
backend/migrate.py
backend/copy_db.py

# Agent / editor scratch
.claude/
.agents/
