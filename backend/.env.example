# LGN Platform backend configuration.
# Copy to `.env` (which is git-ignored) and fill in real values.
#   cp .env.example .env

# --- Database --------------------------------------------------------------
# Local dev defaults to SQLite. docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./lgn_platform.db

# ON VERCEL, DO NOT SET THIS BY HAND. The Neon Marketplace integration injects
# it automatically, already pointed at the POOLED endpoint:
#   DATABASE_URL           pooled   ep-<name>-pooler.<region>.aws.neon.tech
#   DATABASE_URL_UNPOOLED  direct   ep-<name>.<region>.aws.neon.tech
#
# Pooled is what the API wants. It runs as a serverless function that scales
# horizontally, so each instance keeping its own SQLAlchemy pool would exhaust
# Postgres' connection limit; Neon's PgBouncer does that pooling server-side
# instead, and app/database.py sees the `-pooler` host and turns its own pooling
# off to match.
#
# Use the UNPOOLED one for schema work -- migrate.py and copy_db.py both prefer
# DATABASE_URL_UNPOOLED when it is present.
#
# A deployment that leaves this unset falls back to SQLite on a read-only,
# per-instance filesystem -- so the backend refuses to start rather than quietly
# serving an empty database. See app/database.py.

# development | production
#
# Set this to `production` on any deployment. In `development` the API creates
# tables and seeds a sample capsule on startup, which is right for a fresh
# SQLite/Docker database and wrong for one that the SQL migrations own.
ENV=development

# Whether startup builds the schema from app/models.py and seeds a sample
# capsule. Only consulted when ENV=development and never on Vercel.
#
#   true  (default)  zero-setup local dev -- a fresh database just works
#   false            you drive the schema yourself:
#                      uv run python migrate.py up
#                      uv run python migrate.py seed
#
# Use false to exercise the real migrations locally before they run against the
# deployed database. Do not expect both to work: create_all() builds tables from
# the models, and migration 20260720165715 is not idempotent, so it fails on a
# database the models already built.
# DB_BOOTSTRAP=true

# Comma-separated list of browser origins allowed to call this API.
#
# Only needed when the frontend is served from a DIFFERENT origin than the API
# -- which is the local case (Vite on 5173, uvicorn on 8000). On Vercel both are
# one deployment behind one domain, so requests are same-origin and this is
# never consulted.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Admin portal ----------------------------------------------------------
# The internal capsule editor is gated by ONE shared password, held here and
# checked server-side. There are no per-user accounts (and therefore no
# per-user audit trail -- see README).
#
# SECURITY: if ADMIN_PASSWORD is empty or unset, the admin portal is treated as
# NOT CONFIGURED and every /api/admin/* endpoint returns 503, as do the
# content-mutating endpoints under /api/capsules. An unset password NEVER means
# "no authentication required". A deploy that forgets this variable fails
# closed, locked, rather than open to the internet.
#
# Choose something long and random, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# Optional. Secret used to sign issued admin bearer tokens.
#
# Leave EMPTY in normal operation: the signing key is then derived from
# ADMIN_PASSWORD, so changing the password immediately invalidates every token
# already issued. That is the only revocation mechanism a stateless
# single-password scheme has, and it is usually what you want when rotating
# after someone leaves the team.
#
# Set it explicitly only if you want password rotation NOT to sign everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=

# Lifetime of an issued admin token, in hours (default 12 -- about a workday).
ADMIN_TOKEN_TTL_HOURS=12


# --- Geme (Practice > Keep Exploring > Take It Inward) ----------------------
# Anthropic key for the Geme chat companion. Leave EMPTY and the /api/geme/*
# endpoints report themselves unavailable and the frontend hides the entry
# point -- the rest of the platform runs unaffected.
#
# docker-compose reads this file, so both this key and ADMIN_PASSWORD above
# reach the container from here. Do not add either to the `environment:` block
# in docker-compose.yml: values there win over env_file and would shadow
# whatever you set in this file.
ANTHROPIC_API_KEY=

# Optional model/parameter overrides. Defaults live in app/config.py.
# GEME_MODEL=claude-opus-5
# GEME_MAX_TOKENS=1024
# GEME_EFFORT=low

# Live prompt tuning panel. Local development ONLY: with it on, anyone who can
# reach the API can replace Geme's system prompt and spend tokens against this
# server's key. docker-compose sets it for local dev; never enable it on a
# deployed server.
# GEME_DEBUG=false
